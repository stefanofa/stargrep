{
  "extends": "@stargrep/config/tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types", "vite/client"]
  },
  "include": [
    "src",
    "test",
    "website.ts",
    "rate-limit-policy.ts",
    "zone-rate-limit.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["test/**/*.test.ts", "test/**/*.test.tsx"]
}
