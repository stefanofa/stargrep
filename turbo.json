{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "//#lint": {
      "inputs": ["$TURBO_DEFAULT$", "!repos/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "budget": {
      "dependsOn": ["transit"]
    },
    "check": {
      "dependsOn": ["//#lint", "//#lint:fixtures", "typecheck", "budget"]
    },
    "//#lint:fixtures": {
      "inputs": ["packages/config/**"]
    }
  }
}
