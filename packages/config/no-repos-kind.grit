language js

or {
  `repos.kind`,
  `$_.insert(repos)`,
  `$_.select().from(repos)`,
  or { JsStringLiteralExpression(), JsTemplateChunkElement() } as $text where {
    $text <: or {
      r"[\s\S]*\b(?:repos|r)\.kind\b[\s\S]*",
      r"[\s\S]*(?:\bselect|,)\s*kind\s+from\s+repos\b[\s\S]*",
      r"[\s\S]*\binsert\s+into\s+repos\s*\([^)]*\bkind\b[\s\S]*",
      r"[\s\S]*\bupdate\s+repos\s+set\b[^;]*?\bkind\s*=[\s\S]*"
    }
  }
} as $match where {
  register_diagnostic(span=$match, message="repos.kind is legacy, and a migration drops it. Read kinds, whose first entry is the primary kind. A Drizzle insert or select on repos names its columns, because the bare form names every column, kind included.")
}
