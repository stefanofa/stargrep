language js

or {
  or {
    `import $_ from $source`,
    `export { $_ } from $source`,
    `export * from $source`,
    `export * as $_ from $source`,
    `import $source`,
    `import($source)`
  } where {
    $source <: r"[\"'](?:effect/observability(?:/OtlpTracer)?|@alchemy\.run/cloudflare/Workers/CloudflareTracer)[\"']",
    register_diagnostic(span=$source, message="Build tracers with @stargrep/telemetry. Its layers wrap each tracer in withoutResults, so no span keeps a success value.")
  },
  `Cloudflare.Telemetry($_)` as $call where {
    register_diagnostic(span=$call, message="Cloudflare.Telemetry() installs a tracer that keeps span results. Register the layer from @stargrep/telemetry/cloudflare instead.")
  }
}
