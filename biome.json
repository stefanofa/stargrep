{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}",
      "!repos",
      "!packages/db/migrations",
      "!evals/fixtures",
      "!packages/config/fixtures",
      "!apps/web/src/routeTree.gen.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/server.ts", "apps/web/src/server/**", "apps/web/website.ts", "apps/web/test/**"],
      "linter": {
        "domains": {
          "react": "none"
        }
      }
    },
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["drizzle-orm", "drizzle-orm/**", "pg", "pg/**"],
                    "message": "Core reaches Postgres through the Db service in @stargrep/db, never through Drizzle or pg."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/**",
        "!apps/web/src/server.ts",
        "!apps/web/src/server/**",
        "!apps/web/src/routes/api/**",
        "packages/ui/**"
      ],
      "plugins": ["./packages/config/no-runtime-api-import.grit"]
    },
    {
      "includes": ["apps/**", "!apps/**/*.test.ts", "!apps/**/*.test.tsx", "!apps/**/*.workerd-test.ts"],
      "plugins": ["./packages/config/no-local-ai-import.grit"]
    },
    {
      "includes": ["**", "!packages/telemetry/**"],
      "plugins": ["./packages/config/no-raw-tracer-import.grit", "./packages/config/no-raw-tracer-call.grit"]
    }
  ]
}
