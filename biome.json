{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}", "!repos"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/web/src/**",
        "!apps/web/src/server.ts",
        "!apps/web/src/server/**",
        "!apps/web/src/routes/api/**",
        "packages/ui/**"
      ],
      "plugins": ["./packages/config/no-runtime-api-import.grit"]
    }
  ]
}
