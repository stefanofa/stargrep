{
  "name": "stargrep",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "{infra,scripts,evals}"
    ],
    "catalog": {
      "@effect/tsgo": "0.64.1",
      "@types/bun": "1.4.3",
      "@types/pg": "8.23.1",
      "effect": "4.1.2",
      "pg": "8.23.1",
      "typescript": "7.0.2"
    }
  },
  "scripts": {
    "postinstall": "if [ -x node_modules/.bin/effect-tsgo ]; then effect-tsgo patch --typescript --no-oxlint; fi",
    "check": "turbo run check",
    "lint": "biome check .",
    "test": "bun test --parallel",
    "lint:fixtures": "bun packages/config/scripts/lint-fixtures.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@effect/tsgo": "catalog:",
    "turbo": "2.11.10",
    "typescript": "catalog:"
  }
}
