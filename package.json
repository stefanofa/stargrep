{
  "name": "stargrep",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "effect-tsgo patch --typescript --no-oxlint",
    "check": "turbo run check",
    "lint": "biome check .",
    "test": "bun test --parallel"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@effect/tsgo": "0.64.1",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
