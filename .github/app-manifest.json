{
  "name": "Stargrep",
  "url": "https://stargrep.com",
  "description": "Search your starred GitHub repos in plain language.",
  "public": false,
  "callback_urls": ["https://stargrep.com/auth/callback/github", "http://localhost:1340/auth/callback/github"],
  "hook_attributes": { "url": "https://stargrep.com/github/webhook", "active": false },
  "default_permissions": { "emails": "read" },
  "default_events": [],
  "request_oauth_on_install": false,
  "setup_on_update": false
}
